{
  "name": "@gyeoltare/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/main.js",
    "./types": {
      "types": "./dist/types/public-types.d.ts",
      "default": "./src/public-types.ts"
    }
  },
  "scripts": {
    "build": "pnpm run build:runtime && pnpm run build:types",
    "build:runtime": "bun build ./src/main.ts --target bun --outfile ./dist/main.js",
    "build:types": "tsc --project tsconfig.types.json",
    "compile": "pnpm run build && bun build --compile --minify --sourcemap ./dist/main.js --outfile ./dist/gyeoltare-api",
    "dev": "bun --watch ./src/main.ts",
    "start": "bun ./dist/main.js",
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gyeoltare/auth": "workspace:*",
    "@gyeoltare/db": "workspace:*",
    "@gyeoltare/util": "workspace:*",
    "@hono/otel": "^1.1.1",
    "@hono/zod-openapi": "^1.3.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@scalar/hono-api-reference": "^0.10.8",
    "@scalar/openapi-to-markdown": "^0.5.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@gyeoltare/typescript-config": "workspace:*",
    "@types/bun": "^1.2.15"
  }
}
